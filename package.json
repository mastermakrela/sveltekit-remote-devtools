{
	"name": "sveltekit-remote-devtools",
	"version": "0.1.0",
	"description": "Drop-in devtool for SvelteKit remote functions: endpoint explorer, decoded call timeline, refresh trees, live query cache and a playground",
	"keywords": [
		"svelte",
		"sveltekit",
		"remote-functions",
		"devtools",
		"vite-plugin"
	],
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mastermakrela/sveltekit-remote-devtools.git"
	},
	"files": [
		"dist",
		"src/client",
		"DESIGN.md",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client/*": "./src/client/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig tsconfig.client.json",
		"prepack": "tsc -p tsconfig.json",
		"test": "bun test"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2.27.0",
		"svelte": "^5.0.0",
		"vite": ">=6.3.0",
		"typescript": ">=5.0.0 <7",
		"@valibot/to-json-schema": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		},
		"@valibot/to-json-schema": {
			"optional": true
		}
	},
	"dependencies": {
		"devalue": "^5.0.0"
	},
	"devDependencies": {
		"@standard-schema/spec": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@types/node": "^26.6.3",
		"@valibot/to-json-schema": "^1.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	}
}
