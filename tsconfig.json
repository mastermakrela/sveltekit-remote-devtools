{
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ESNext"],
		"types": ["node"],
		"strict": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src/node",
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"sourceMap": true
	},
	"include": ["src/node"]
}
